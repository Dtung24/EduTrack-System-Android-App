# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE CONFIGURATION (Placeholder fallbacks to prevent startup crash when google-services.json is absent)
FIREBASE_API_KEY=MockApiKeyForEduTrackAppToPreventStartupCrashes
FIREBASE_APPLICATION_ID=1:1234567890:android:a1b2c3d4e5f6
FIREBASE_DATABASE_URL=https://edutrack-mock-db.firebaseio.com
FIREBASE_PROJECT_ID=edutrack-mock-db

